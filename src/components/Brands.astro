---
import { brands } from '../data/site';
---

<section class="border-y border-line py-10 md:py-12" aria-labelledby="brands-title">
  <div class="container-x mb-7 flex items-center justify-between gap-4">
    <h2 id="brands-title" class="label-mono text-mute" data-reveal>Brands I've edited for</h2>
    <span class="hidden h-px flex-1 bg-line md:block" aria-hidden="true"></span>
  </div>
  <div class="marquee" aria-label={brands.map((b) => b.name).join(', ')}>
    {
      [0, 1].map((copy) => (
        <ul class="marquee-track" aria-hidden={copy === 1 ? 'true' : undefined}>
          {brands.map((b) => (
            <li>
              <img src={b.logo} alt={copy === 0 ? b.name : ''} loading="lazy" decoding="async" height="40" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .marquee {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-track {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: clamp(3rem, 7vw, 6rem);
    padding-right: clamp(3rem, 7vw, 6rem);
    animation: marquee 42s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  .marquee img {
    height: clamp(1.6rem, 3vw, 2.3rem);
    width: auto;
    max-width: none;
    filter: brightness(0) invert(0.92);
    opacity: 0.55;
    transition:
      filter 0.4s,
      opacity 0.4s;
  }
  .marquee li:hover img {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
    }
    .marquee-track {
      flex-wrap: wrap;
      justify-content: center;
      flex-shrink: 1;
      padding: 0 var(--gutter);
      row-gap: 2rem;
    }
    .marquee-track[aria-hidden] {
      display: none;
    }
  }
</style>
