---
import { contact } from '../data/site';
const wa = `https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent(contact.whatsappMessage)}`;
---

<div class="mcta md:hidden" data-mobile-cta>
  <a href="#work" class="btn btn-ghost flex-1 !min-h-12 !bg-ink/80">See work</a>
  <a href={wa} target="_blank" rel="noopener" class="btn btn-primary flex-[1.4] !min-h-12">Hire me on WhatsApp</a>
</div>

<style>
  .mcta {
    position: fixed;
    left: 0.75rem;
    right: 0.75rem;
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    z-index: 80;
    display: flex;
    gap: 0.5rem;
    padding: 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    background: rgb(20 18 16 / 0.8);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transform: translateY(150%);
    transition: transform 0.6s var(--ease-out-expo);
  }
  @media (min-width: 768px) {
    .mcta {
      display: none;
    }
  }
  .mcta.is-visible {
    transform: none;
  }
  :global(html.menu-open) .mcta,
  :global(html.player-open) .mcta {
    transform: translateY(150%);
  }
</style>
