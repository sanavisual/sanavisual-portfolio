---
/**
 * Renders text word-by-word for the masked headline reveal.
 * Wrap a word in *asterisks* to style it as the serif accent.
 */
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'p' | 'span';
  class?: string;
  delay?: number;
  id?: string;
}
const { text, as: Tag = 'h2', class: cls = '', delay = 0, id } = Astro.props;
const lines = text.split('\n');
let i = 0;
---

<Tag class={cls} data-split style={`--base:${delay}ms`} id={id}>
  {
    lines.map((line, li) => (
      <>
        {line
          .split(' ')
          .filter(Boolean)
          .map((word) => {
            const accent = /^\*.*\*[.,!?]?$/.test(word);
            const clean = word.replace(/\*/g, '');
            return (
              <>
                <span class="split-word">
                  <span class={accent ? 'serif-accent pr-[0.06em]' : undefined} style={`--i:${i++}`}>
                    {clean}
                  </span>
                </span>{' '}
              </>
            );
          })}
        {li < lines.length - 1 && <br />}
      </>
    ))
  }
</Tag>
