---
/**
 * Viewfinder crosshair cursor (desktop / mouse only).
 * Behaviour lives in src/scripts/cursor.ts.
 *
 * Hover states are chosen automatically for links and buttons.
 * Add data-cursor="play" to an element for the video "PLAY" frame,
 * data-cursor="hide" to hide it, or data-cursor-lines to a section
 * to show the full-screen hairlines while the mouse is inside it.
 */
---

<div class="cursor" aria-hidden="true">
  <div class="cursor-line cursor-line-x"></div>
  <div class="cursor-line cursor-line-y"></div>
  <div class="cursor-ring">
    <i class="tick t"></i><i class="tick r"></i><i class="tick b"></i><i class="tick l"></i>
    <i class="corner tl"></i><i class="corner tr"></i><i class="corner br"></i><i class="corner bl"></i>
    <span class="cursor-label label-mono">▶ Play</span>
  </div>
  <div class="cursor-dot"></div>
</div>

<style>
  .cursor {
    display: none;
  }
  :global(html.has-cursor) .cursor {
    display: block;
  }
  :global(html.has-cursor),
  :global(html.has-cursor *) {
    cursor: none !important;
  }
  :global(html.has-cursor input),
  :global(html.has-cursor textarea),
  :global(html.has-cursor select),
  :global(html.has-cursor video::-webkit-media-controls-panel) {
    cursor: auto !important;
  }

  .cursor > * {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 300;
  }
  .cursor-dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    border-radius: 99px;
    background: var(--color-sand);
    transition:
      opacity 0.25s,
      width 0.3s var(--ease-out-expo),
      height 0.3s var(--ease-out-expo),
      margin 0.3s var(--ease-out-expo);
  }

  .cursor-ring {
    --s: 38px;
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    border: 1px solid rgb(243 238 231 / 0.55);
    border-radius: 99px;
    mix-blend-mode: difference;
    transition:
      width 0.45s var(--ease-out-expo),
      height 0.45s var(--ease-out-expo),
      margin 0.45s var(--ease-out-expo),
      border-color 0.3s,
      border-radius 0.45s var(--ease-out-expo),
      background-color 0.3s,
      opacity 0.3s;
  }
  /* Crosshair ticks */
  .tick {
    position: absolute;
    background: rgb(243 238 231 / 0.9);
    transition:
      transform 0.45s var(--ease-out-expo),
      opacity 0.3s;
  }
  .tick.t,
  .tick.b {
    left: 50%;
    width: 1px;
    height: 8px;
    margin-left: -0.5px;
  }
  .tick.l,
  .tick.r {
    top: 50%;
    height: 1px;
    width: 8px;
    margin-top: -0.5px;
  }
  .tick.t {
    top: -5px;
  }
  .tick.b {
    bottom: -5px;
  }
  .tick.l {
    left: -5px;
  }
  .tick.r {
    right: -5px;
  }

  /* Viewfinder corners (shown on videos) */
  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid var(--color-cream);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .corner.tl {
    top: 0;
    left: 0;
    border-top-width: 1.5px;
    border-left-width: 1.5px;
  }
  .corner.tr {
    top: 0;
    right: 0;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
  }
  .corner.br {
    bottom: 0;
    right: 0;
    border-bottom-width: 1.5px;
    border-right-width: 1.5px;
  }
  .corner.bl {
    bottom: 0;
    left: 0;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
  }
  .cursor-label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 0.66rem;
    color: var(--color-cream);
    opacity: 0;
    transition: opacity 0.25s;
    white-space: nowrap;
  }

  /* Full-screen hairlines */
  .cursor-line {
    background: rgb(214 180 140 / 0.16);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .cursor-line-x {
    width: 100vw;
    height: 1px;
  }
  .cursor-line-y {
    width: 1px;
    height: 100vh;
  }

  /* ── States ── */
  :global(.cursor.is-lines) .cursor-line {
    opacity: 1;
  }
  :global(.cursor.is-link) .cursor-ring {
    --s: 62px;
    border-color: rgb(243 238 231 / 0.9);
  }
  :global(.cursor.is-link) .tick.t {
    transform: translateY(9px);
  }
  :global(.cursor.is-link) .tick.b {
    transform: translateY(-9px);
  }
  :global(.cursor.is-link) .tick.l {
    transform: translateX(9px);
  }
  :global(.cursor.is-link) .tick.r {
    transform: translateX(-9px);
  }
  :global(.cursor.is-link) .cursor-dot {
    opacity: 0;
  }

  :global(.cursor.is-play) .cursor-ring {
    --s: 92px;
    border-radius: 4px;
    border-color: transparent;
    mix-blend-mode: normal;
    background: rgb(11 10 9 / 0.35);
    backdrop-filter: blur(6px);
  }
  :global(.cursor.is-play) .tick {
    opacity: 0;
  }
  :global(.cursor.is-play) .corner,
  :global(.cursor.is-play) .cursor-label {
    opacity: 1;
  }
  :global(.cursor.is-play) .cursor-dot {
    opacity: 0;
  }

  :global(.cursor.is-hidden) .cursor-ring,
  :global(.cursor.is-hidden) .cursor-dot,
  :global(.cursor.is-out) > * {
    opacity: 0 !important;
  }
  :global(.cursor.is-down) .cursor-ring {
    --s: 30px;
  }
</style>
