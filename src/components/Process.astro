---
import SplitText from './SplitText.astro';
import SectionLabel from './SectionLabel.astro';
import { process } from '../data/site';
---

<section id="process" class="py-24 md:py-36" aria-labelledby="process-title">
  <div class="container-x">
    <SectionLabel index="03" label="How it works" />
    <SplitText id="process-title" text="From raw footage\nto *final cut.*" class="mt-5 font-display text-[clamp(2.5rem,6.5vw,5.5rem)]" />

    <div class="timeline mt-14 md:mt-20" data-timeline>
      <div class="tl-track" aria-hidden="true">
        <span class="tl-fill" data-timeline-fill></span>
      </div>
      <ol class="tl-steps">
        {
          process.map((p, i) => (
            <li class="tl-step" data-step data-reveal style={`--d:${i}`}>
              <span class="tl-marker" aria-hidden="true" />
              <span class="font-mono text-xs text-sand">{p.step}</span>
              <h3 class="mt-3 text-xl font-semibold tracking-tight">{p.title}</h3>
              <p class="mt-2 text-mute leading-relaxed">{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
  }
  .tl-track {
    position: absolute;
    background: var(--color-line-strong);
    left: 0.4rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
  }
  .tl-fill {
    position: absolute;
    inset: 0;
    background: var(--color-sand);
    transform-origin: top;
    transform: scaleY(0);
  }
  .tl-steps {
    display: grid;
    gap: 2.75rem;
  }
  .tl-step {
    position: relative;
    padding-left: 2.25rem;
  }
  .tl-marker {
    position: absolute;
    left: 0;
    top: 0.2rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 99px;
    border: 1px solid var(--color-mute);
    background: var(--color-ink);
    transition:
      background-color 0.4s,
      border-color 0.4s,
      box-shadow 0.4s;
  }
  :global(.tl-step.is-active) .tl-marker {
    background: var(--color-sand);
    border-color: var(--color-sand);
    box-shadow: 0 0 0 5px rgb(214 180 140 / 0.15);
  }
  @media (min-width: 768px) {
    .tl-track {
      left: 0;
      right: 0;
      top: 0.4rem;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .tl-fill {
      transform-origin: left;
      transform: scaleX(0);
    }
    .tl-steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
    }
    .tl-step {
      padding-left: 0;
      padding-top: 2.5rem;
    }
    .tl-marker {
      top: 0;
    }
  }
</style>
