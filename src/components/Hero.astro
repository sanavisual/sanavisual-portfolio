---
import SplitText from './SplitText.astro';
import { site, contact, brands } from '../data/site';
import { projects, mediaFor } from '../data/projects';

const reel = projects.filter((p) => p.featured).slice(0, 3);
const wa = `https://wa.me/${contact.whatsappNumber}?text=${encodeURIComponent(contact.whatsappMessage)}`;
---

<section id="top" class="hero grain" data-cursor-lines aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="container-x relative">
    <!-- Viewfinder frame -->
    <div class="vf" aria-hidden="true">
      <i class="vf-c tl"></i><i class="vf-c tr"></i><i class="vf-c bl"></i><i class="vf-c br"></i>
      <div class="vf-top">
        <span class="flex items-center gap-2"><span class="rec-dot"></span><span class="text-cream">Rec</span></span>
        <span class="font-mono tabular-nums" data-timecode>00:00:00:00</span>
      </div>
    </div>

    <div class="hero-grid">
      <div class="relative z-10">
        <p class="chip mb-7" data-reveal>
          <span class="h-1.5 w-1.5 rounded-full bg-sand"></span>
          {site.tagline.join(' · ')}
        </p>

        <SplitText
          as="h1"
          id="hero-title"
          text={'Turning ideas\ninto *scroll-worthy*\nvideos.'}
          class="font-display text-[clamp(2.75rem,7.6vw,6.6rem)]"
          delay={150}
        />

        <p class="mt-7 max-w-[34rem] text-[clamp(1rem,1.4vw,1.15rem)] leading-relaxed text-mute" data-reveal style="--d:4">
          I edit <span class="text-cream">UGC ads, direct-response creatives, VSLs</span> and
          <span class="text-cream">AI-powered videos</span> for e-commerce brands, businesses and creators — built to grab attention and
          drive action.
        </p>

        <div class="mt-9 flex flex-col gap-3 xs:flex-row" data-reveal style="--d:5">
          <a href="#work" class="btn btn-primary">
            View my work
            <span class="btn-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17 17 7M8 7h9v9"></path></svg>
            </span>
          </a>
          <a href={wa} target="_blank" rel="noopener" class="btn btn-ghost">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4C2.7 15.6 2.2 13.8 2.2 12 2.2 6.6 6.6 2.2 12 2.2c2.6 0 5.1 1 6.9 2.9 1.8 1.8 2.9 4.3 2.9 6.9 0 5.4-4.4 9.8-9.8 9.8zm8.4-18.2A11.8 11.8 0 0 0 12 0C5.4 0 .1 5.3.1 11.9c0 2.1.5 4.1 1.6 5.9L0 24l6.3-1.7c1.7.9 3.7 1.4 5.7 1.4 6.6 0 11.9-5.3 11.9-11.9 0-3.2-1.2-6.2-3.5-8.4z"></path></svg>
            WhatsApp me
          </a>
        </div>

        <dl class="proof" data-reveal style="--d:6">
          <div>
            <dt class="label-mono text-faint">Experience</dt>
            <dd><span class="text-sand">{site.yearsExperience}</span> years editing</dd>
          </div>
          <div>
            <dt class="label-mono text-faint">Brands</dt>
            <dd><span class="text-sand">{brands.length}</span> brands edited for</dd>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <dt class="label-mono text-faint">Focus</dt>
            <dd>UGC · Ads · AI videos</dd>
          </div>
        </dl>
      </div>

      <!-- Reel stack -->
      <div class="reel-wrap" data-reveal style="--d:3">
        <div class="reel" data-reel>
          {
            reel.map((p, i) => {
              const m = mediaFor(p);
              return (
                <a href="#work" class={`reel-card rc-${i}`} data-cursor="play" data-cursor-label="View work" aria-label={`${p.title} — view work`}>
                  <video muted loop playsinline preload="none" poster={m.poster} data-src={m.preview} aria-hidden="true" tabindex="-1" />
                  <span class="reel-tag label-mono">{p.brand ?? p.title}</span>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>

  <a href="#work" class="scroll-cue" aria-label="Scroll to work">
    <span class="label-mono">Scroll</span>
    <span class="scrub"><i></i></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(var(--header-h) + 4rem) 0 6rem;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 72% 45%, rgb(214 180 140 / 0.13), transparent 70%),
      radial-gradient(40% 40% at 10% 100%, rgb(255 59 48 / 0.05), transparent 70%),
      linear-gradient(to right, rgb(243 238 231 / 0.035) 1px, transparent 1px) 0 0 / calc(100% / 12) 100%;
    mask-image: radial-gradient(120% 90% at 50% 40%, #000 55%, transparent 100%);
  }
  .hero-grid {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.8fr);
      gap: 2rem;
    }
  }

  /* Viewfinder frame */
  .vf {
    position: absolute;
    inset: -3.25rem calc(var(--gutter) - 1.25rem) -2.5rem;
    pointer-events: none;
    display: none;
  }
  @media (min-width: 768px) {
    .vf {
      display: block;
    }
  }
  .vf-c {
    position: absolute;
    width: 1.6rem;
    height: 1.6rem;
    border: 0 solid rgb(243 238 231 / 0.35);
  }
  .vf-c.tl {
    top: 0;
    left: 0;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .vf-c.tr {
    top: 0;
    right: 0;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  .vf-c.bl {
    bottom: 0;
    left: 0;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .vf-c.br {
    bottom: 0;
    right: 0;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }
  .vf-top {
    position: absolute;
    top: 0.9rem;
    left: 2.4rem;
    right: 2.4rem;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .proof {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    max-width: 34rem;
  }
  @media (min-width: 640px) {
    .proof {
      grid-template-columns: repeat(3, auto);
      justify-content: start;
    }
  }
  .proof dd {
    margin-top: 0.35rem;
    font-size: 0.95rem;
  }

  /* Reel stack */
  .reel-wrap {
    display: flex;
    justify-content: center;
  }
  .reel {
    --w: clamp(8.5rem, 26vw, 15.5rem);
    position: relative;
    width: calc(var(--w) * 2.15);
    height: calc(var(--w) * 16 / 9 + 2rem);
  }
  @media (min-width: 1024px) {
    .reel {
      --w: clamp(8.5rem, 17vw, 15.5rem);
    }
  }
  .reel-card {
    position: absolute;
    top: 1rem;
    left: 50%;
    width: var(--w);
    aspect-ratio: 9 / 16;
    margin-left: calc(var(--w) / -2);
    border-radius: clamp(0.9rem, 2vw, 1.4rem);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-line-strong);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.8);
    transition: transform 0.9s var(--ease-out-expo);
  }
  .reel-card video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rc-0 {
    z-index: 2;
  }
  .rc-1 {
    transform: translateX(-62%) rotate(-8deg) scale(0.86);
    filter: brightness(0.7);
  }
  .rc-2 {
    transform: translateX(62%) rotate(8deg) scale(0.86);
    filter: brightness(0.7);
  }
  .rc-1,
  .rc-2 {
    transition:
      transform 0.9s var(--ease-out-expo),
      filter 0.5s;
  }
  @media (hover: hover) {
    .reel:hover .rc-1 {
      transform: translateX(-78%) rotate(-11deg) scale(0.88);
      filter: brightness(0.9);
    }
    .reel:hover .rc-2 {
      transform: translateX(78%) rotate(11deg) scale(0.88);
      filter: brightness(0.9);
    }
    .reel:hover .rc-0 {
      transform: translateY(-0.5rem);
    }
  }
  .reel-tag {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    font-size: 0.6rem;
    background: rgb(11 10 9 / 0.6);
    backdrop-filter: blur(8px);
    color: var(--color-cream);
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: none;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-mute);
  }
  @media (min-width: 768px) and (min-height: 700px) {
    .scroll-cue {
      display: flex;
    }
  }
  .scrub {
    position: relative;
    width: 4.5rem;
    height: 1px;
    background: var(--color-line-strong);
  }
  .scrub i {
    position: absolute;
    top: -3px;
    left: 0;
    width: 1px;
    height: 7px;
    background: var(--color-sand);
    animation: scrub 2.4s var(--ease-in-out-quart) infinite;
  }
  @keyframes scrub {
    0% {
      left: 0;
    }
    50% {
      left: 100%;
    }
    100% {
      left: 0;
    }
  }
</style>
