---
import SectionLabel from './SectionLabel.astro';
import { about, site } from '../data/site';
---

<section id="about" class="py-24 md:py-36 border-t border-line" aria-labelledby="about-title">
  <div class="container-x grid gap-12 md:grid-cols-[0.85fr_1.15fr] md:items-center lg:gap-20">
    <div class="photo-frame" data-reveal>
      {
        about.photo ? (
          <img src={about.photo} alt={about.name ? `${about.name}, video editor` : `${site.brand} video editor`} loading="lazy" decoding="async" />
        ) : (
          <div class="photo-placeholder">
            <svg viewBox="0 0 32 32" width="48" height="48" aria-hidden="true">
              <path d="M3 10V3h7M22 3h7v7M29 22v7h-7M10 29H3v-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <span class="label-mono">Photo placeholder</span>
            <span class="text-xs text-faint">Add your headshot in src/data/site.ts</span>
          </div>
        )
      }
      <span class="photo-tag label-mono"><span class="rec-dot"></span> Based in {site.location}</span>
    </div>

    <div>
      <SectionLabel index="05" label="About" />
      <h2 id="about-title" class="mt-5 font-display text-[clamp(2.3rem,5.5vw,4.5rem)]" data-reveal>
        {about.name ? <>Hi, I'm {about.name} —</> : <>The editor behind</>}
        <span class="serif-accent"> {site.brand}.</span>
      </h2>
      <div class="mt-8 grid gap-5 text-[1.05rem] leading-relaxed text-mute">
        {about.paragraphs.map((p, i) => <p data-reveal style={`--d:${i + 1}`}>{p}</p>)}
      </div>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--d:3">
        <a href="#contact" class="btn btn-primary">Start a project</a>
        <a href="#work" class="btn btn-ghost">See the work</a>
      </div>
    </div>
  </div>
</section>

<style>
  .photo-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 30rem;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-placeholder {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    text-align: center;
    color: var(--color-mute);
    border: 1px dashed var(--color-line-strong);
    border-radius: inherit;
    background:
      radial-gradient(50% 40% at 50% 45%, rgb(214 180 140 / 0.08), transparent),
      var(--color-surface);
  }
  .photo-tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    font-size: 0.65rem;
    background: rgb(11 10 9 / 0.65);
    backdrop-filter: blur(8px);
  }
</style>
